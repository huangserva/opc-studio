    {
      "tweet_id": "2110919336147796377",
      "author_handle": "dotey",
      "author_handle_observed": true,
      "author_handle_normalized": "dotey",
      "author_user_id": "3178231",
      "queried_handle": "dotey",
      "kind": "original",
